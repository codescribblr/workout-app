# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI Configuration
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Vercel Configuration (for CI/CD)
# These are automatically set by Vercel, but needed for GitHub Actions
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id

# Node Environment
NODE_ENV=development

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Database Connection (for migrations)
# Format: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Or use SUPABASE_DB_PASSWORD + NEXT_PUBLIC_SUPABASE_URL (script will construct URL)
SUPABASE_DB_URL=your_database_url_here
SUPABASE_DB_PASSWORD=your_database_password_here
