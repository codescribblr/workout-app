{
  "name": "workout-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "migrate": "bash -c 'export PATH=\"/opt/homebrew/opt/postgresql@17/bin:$PATH\" 2>/dev/null || export PATH=\"/usr/local/opt/postgresql@17/bin:$PATH\" 2>/dev/null || true; set -a && source .env.local && set +a && chmod +x scripts/run-migrations.sh && ./scripts/run-migrations.sh'",
    "migrate:check": "set -a && source .env.local && set +a && chmod +x scripts/check-pending-migrations.sh && ./scripts/check-pending-migrations.sh"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.39.3",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "next": "14.1.0",
    "openai": "^4.24.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.1.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
